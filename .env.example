# ==============================================================================
# THUYPD.SITE Landing Page — Cấu hình biến môi trường (.env)
# ==============================================================================

# 1. URL Backend API Trung Tâm (BẮT BUỘC - Server-side only, KHÔNG bị lộ ra browser)
# - Dùng cho cơ chế Backend Proxy ẩn danh: Browser chỉ gọi /api/... nội bộ
# - Local Dev: http://localhost:5000
# - Production (Vercel Dashboard / VPS): Điền URL backend của bạn (vd: https://api.yourdomain.com)
BACKEND_API_URL="http://localhost:5000"

# 2. Canonical Site URL (BẮT BUỘC - Dùng cho SEO Canonical, OpenGraph, JSON-LD, Sitemap)
# - Local Dev: http://localhost:3000
# - Production (Vercel Dashboard / VPS): Điền domain chính thức (vd: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
